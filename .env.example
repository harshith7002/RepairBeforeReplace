# Optional: enables real AI vision diagnosis (Anthropic Claude) instead of the
# built-in deterministic knowledge-base engine. Copy this file to .env.local and
# fill in your key to turn it on — the app works fully without it.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for vision diagnosis (must be a vision-capable
# Claude model available on your account). Defaults to claude-3-5-sonnet-20241022.
ANTHROPIC_MODEL=
